{
    "name": "carljanzell/filament-page-builder",
    "description": "A drag-and-drop visual page builder for Filament, storing content as ordered typed blocks.",
    "type": "library",
    "keywords": [
        "filament",
        "filament-plugin",
        "laravel",
        "livewire",
        "page-builder",
        "drag-and-drop"
    ],
    "homepage": "https://darkify19.github.io/filament-page-builder/",
    "license": "MIT",
    "authors": [
        {
            "name": "Carl Janzell",
            "email": "carl.oropesa11@gmail.com"
        }
    ],
    "support": {
        "email": "carl.oropesa11@gmail.com",
        "issues": "https://github.com/Darkify19/filament-page-builder/issues",
        "source": "https://github.com/Darkify19/filament-page-builder",
        "docs": "https://darkify19.github.io/filament-page-builder/"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^3.3.53"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "livewire/livewire": "^3.5",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "CarlJanzell\\FilamentPageBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarlJanzell\\FilamentPageBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CarlJanzell\\FilamentPageBuilder\\PageBuilderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint --test",
        "format": "pint"
    }
}
